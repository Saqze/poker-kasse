rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validId(s) { return s is string && s.matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'); }
    function validPlayer(p) {
      return p is map && p.keys().hasAll(['id','name','buyins','final'])
        && p.keys().hasOnly(['id','name','buyins','final'])
        && validId(p.id) && p.name is string && p.name.size() > 0 && p.name.size() <= 40
        && p.buyins is int && p.buyins >= 0 && p.buyins <= 100
        && p.final is number && p.final >= 0 && p.final <= 20000;
    }
    function validPlayers(ps) {
      return ps is list && ps.size() <= 10
        && (ps.size() < 1 || validPlayer(ps[0]))
        && (ps.size() < 2 || validPlayer(ps[1]))
        && (ps.size() < 3 || validPlayer(ps[2]))
        && (ps.size() < 4 || validPlayer(ps[3]))
        && (ps.size() < 5 || validPlayer(ps[4]))
        && (ps.size() < 6 || validPlayer(ps[5]))
        && (ps.size() < 7 || validPlayer(ps[6]))
        && (ps.size() < 8 || validPlayer(ps[7]))
        && (ps.size() < 9 || validPlayer(ps[8]))
        && (ps.size() < 10 || validPlayer(ps[9]));
    }
    // The event log is optional bookkeeping; validate its bounded container.
    // Previous deeply nested event/player validation could exhaust rules evaluation.
    function validEvents(es) {
      return es is list && es.size() <= 20;
    }
    function validHistory(h) {
      // Maximal 50 abgeschlossene Abende, jeweils mit bis zu 10 Spielern.
      // Spielerlisten in alten Abenden werden beim Schreiben nur grob begrenzt.
      return h is list && h.size() <= 50;
    }
    function validRoom(d) {
      return d.keys().hasAll(['players','created','events'])
        && d.keys().hasOnly(['players','created','events','history'])
        && d.created is number && d.created > 0
        && validPlayers(d.players) && validEvents(d.events)
        && (!('history' in d) || validHistory(d.history));
    }
    match /rooms/{roomId} {
      // Der lange, zufällige Einladungslink ist derzeit der Zugangsschlüssel.
      // KEIN PIN-Schutz: wer die Runden-ID kennt, darf lesen und bearbeiten.
      allow get: if signedIn() && validId(roomId);
      allow create: if signedIn() && validId(roomId) && validRoom(request.resource.data)
        && request.resource.data.events.size() == 0
        && (!('history' in request.resource.data) || request.resource.data.history.size() == 0);
      allow update: if signedIn() && validId(roomId) && validRoom(request.resource.data)
        && request.resource.data.created == resource.data.created;
      allow list, delete: if false;
    }
    function validResult(d, roomId) {
      return d.keys().hasAll(['roomId','at','players'])
        && d.keys().hasOnly(['roomId','at','players'])
        && d.roomId == roomId && d.at is number && d.at > 0
        && validPlayers(d.players) && d.players.size() > 0;
    }
    match /results/{roomId} {
      // Testmodus: Angemeldete Nutzer dürfen Ergebnisse löschen.
      // Achtung: Anonyme Anmeldung ist KEIN Administrator-Schutz!
      allow get, list: if signedIn();
      // Nur Ergebnisse aus dem zuletzt archivierten Zustand der verknüpften Runde.
      allow create: if signedIn() && validId(roomId)
        && validResult(request.resource.data, roomId)
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.history is list
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.history.size() > 0
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.history[
          getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.history.size() - 1
        ].players == request.resource.data.players
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.history[
          getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.history.size() - 1
        ].at == request.resource.data.at;
      // Nur vollständige Spielereinträge entfernen; keine bestehenden Einträge verändern.
      allow update: if signedIn() && validId(roomId)
        && request.resource.data.keys().hasOnly(['roomId','at','players'])
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.at == resource.data.at
        && request.resource.data.players is list
        && request.resource.data.players.size() > 0
        && request.resource.data.players.size() < resource.data.players.size()
        && request.resource.data.players.hasOnly(resource.data.players)
        && validPlayers(request.resource.data.players);
      allow delete: if signedIn();
    }

  }
}
